{
  "experiment_name": "Experiment C - Combined PlantVillage + PlantDoc",
  "model_architecture": "mobilenet_v3_small",
  "pretrained_weights": "ImageNet-1K",
  "num_classes": 17,
  "train_csv": "ml/experiments/dataset/manifests/combined_train.csv",
  "val_csv": "ml/experiments/dataset/manifests/combined_val.csv",
  "epochs_phase1": 3,
  "epochs_phase2": 7,
  "batch_size": 64,
  "lr_head": 5e-4,
  "lr_backbone": 1e-4,
  "optimizer": "AdamW",
  "weight_decay": 1e-4,
  "scheduler": "CosineAnnealingLR",
  "use_domain_sampler": true,
  "plantdoc_weight": 0.35,
  "augmentation": {
    "resize": [256, 256],
    "random_resized_crop": [224, [0.75, 1.0]],
    "random_horizontal_flip": 0.5,
    "random_vertical_flip": 0.2,
    "random_rotation": 20,
    "random_perspective": 0.15,
    "color_jitter": {
      "brightness": 0.25,
      "contrast": 0.25,
      "saturation": 0.25,
      "hue": 0.08
    }
  },
  "seed": 42,
  "device": "mps"
}
