GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Voice transcription uses Groq Whisper Large V3 Turbo.
# Voice playback uses OpenAI GPT-4o mini TTS; keys remain backend-only.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ROUTER_MODE=keyword
ROUTER_THRESHOLD=0.45
ROUTER_COST_LAMBDA=0.02
AGRONOMIC_WEIGHT=0.6
ECONOMIC_WEIGHT=0.4
MAX_REVISIONS=2
# free: https://www.weatherapi.com
WEATHER_API_KEY=
# free: https://data.gov.in (Agmarknet)
MARKET_API_KEY=
# alias for MARKET_API_KEY
DATA_GOV_API_KEY=
WEATHER_CACHE_TTL_SECONDS=3600
MARKET_CACHE_TTL_SECONDS=21600
# UPAg yield data (free registration): https://data.upag.gov.in/
UPAG_API_USERNAME=
UPAG_API_PASSWORD=

# Neon Postgres (Dashboard → Connection string). Falls back to local SQLite if unset.
# Example: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Required in production — generate a long random string
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
