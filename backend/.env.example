# development | production (production requires strong JWT_SECRET + Postgres DATABASE_URL)
APP_ENV=development
# Comma-separated browser origins allowed to call the API (include your Vercel URL in prod)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://krishi-ai-ruddy.vercel.app

GROQ_API_KEY=
# Optional extras for demo load (comma-separated). Tried on 429/auth/quota after GROQ_API_KEYS order + GROQ_API_KEY.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
# Raise if Hindi / long advice truncates mid-sentence (was hardcoded 750).
GROQ_MAX_TOKENS=2200
# Voice transcription uses Groq Whisper Large V3 Turbo.
# Voice playback uses OpenAI GPT-4o mini TTS; keys remain backend-only.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ROUTER_MODE=keyword
ROUTER_THRESHOLD=0.45
ROUTER_COST_LAMBDA=0.02
AGRONOMIC_WEIGHT=0.6
ECONOMIC_WEIGHT=0.4
MAX_REVISIONS=2
# free: https://www.weatherapi.com
WEATHER_API_KEY=
# free: https://data.gov.in (Agmarknet)
MARKET_API_KEY=
# alias for MARKET_API_KEY
DATA_GOV_API_KEY=
WEATHER_CACHE_TTL_SECONDS=3600
MARKET_CACHE_TTL_SECONDS=21600
# UPAg yield data (free registration): https://data.upag.gov.in/
UPAG_API_USERNAME=
UPAG_API_PASSWORD=

# Neon Postgres (Dashboard → Connection string). Falls back to local SQLite if unset.
# Example: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Required in production — generate a long random string (≥32 chars)
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Vision: heuristic | mobilenetv3
# Free demo path: VISION_MODEL=mobilenetv3 + VISION_INFERENCE_URL=https://<you>-krishiai-vision.hf.space
# (see deploy/hf-space/). In-process torch needs: uv sync --extra vision + ≥2GB RAM.
VISION_MODEL=heuristic
VISION_CONFIDENCE_THRESHOLD=0.60
VISION_INFERENCE_URL=
VISION_INFERENCE_CONNECT_TIMEOUT=15
VISION_INFERENCE_READ_TIMEOUT=120
HF_MODEL_REPO=Ishan2702/krishiai-mobilenetv3
HF_MODEL_FILENAME=mobilenetv3_plantdisease_best.pth
HF_TOKEN=

